# AnxOS Agent environment overrides (example).
#
# The systemd unit already sets safe local defaults. Rename/copy this file to
# /etc/anxos-agent/agent.env and uncomment what you need. The service reads the
# file AFTER the unit's own Environment= entries, so values here win.
#
# Recommended: chmod 0600 /etc/anxos-agent/agent.env

# --- Network opt-in -------------------------------------------------------
# The Agent listens on loopback only by default. Binding to a non-loopback
# address exposes the Agent API to the network; do this only on a host that is
# protected by a firewall and whose pairing/token lifecycle you understand.
#AGENT_HOST=0.0.0.0
#AGENT_PORT=47131

# --- Data locations (defaults shown) -------------------------------------
#ANXHUB_CONFIG_DIR=/var/lib/anxos-agent/config
#AGENT_INSTANCE_ROOT=/var/lib/anxos-agent/instances
#AGENT_BACKUP_ROOT=/var/lib/anxos-agent/backups
#ANXOS_LOG_DIR=/var/log/anxos-agent

# --- Permission profile ---------------------------------------------------
# The package sets ANXHUB_CONFIG_DIR on purpose: the Agent treats that variable
# as the local-owner signal and grants the full local-owner permission profile
# (agent/src/permissions.js). For an exposed deployment, explicitly fail closed:
#AGENT_PERMISSION_PROFILE=restricted
#
# Additional explicit capability grants, comma or space separated (additive to
# the active profile). Leave empty to rely on the profile alone:
#AGENT_API_PERMISSIONS=

#NODE_ENV=production
