!.env.example

dist-verify/
artifacts/
.npm-cache/
release-artifacts/

# Smoke-run fallback residue: any cwd-relative instance root proves a smoke
# failed to pin AGENT_INSTANCE_ROOT (rc-validate trips on this pre-run). The
# agent's backup root is dirname(instanceRoot)/backups, so it leaks the same way
# and must never be swept into a commit (it can hold real backup payloads).
/instances/
/anxos-instances/
/backups/

# Codex temporary Electron smoke test profiles
.tmp-electron-smoke-profile*
.tmp-sidebar-*.js

# AI tooling local state
.mimosa/
.v2c/

# Agent mode runtime data if bind mounts are used instead of named volumes.
config/marketplace.json
config/agent.json
config/owner-accounts.json
config/node-agent-credentials.json
config/long-operations.json
config/application-host.json
config/nodes.json
config/ssh-known-hosts.json
config/device-identity.json
config/enrollment.json
config/*.backup
agent/.env
agent/config/
*.env
agent/*.log
release-build.json
resources/hardware-telemetry/
resources/bundled-runtimes/
tools/windows-hardware-telemetry/bin/
tools/windows-hardware-telemetry/obj/

# Owner Workspace local development/private data
.anxos-owner-workspace/
.anxos-dev-credentials*
owner-workspace/
config/owner-workspace/

# Supabase CLI local project metadata.
supabase/.temp/

# Code-signing certificates and private keys must never be committed.
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.pvk
*.spc
certs/
signing/
